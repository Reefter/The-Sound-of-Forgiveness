{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "gcc -Wall -Wextra -g -std=c17 -O3 -march=native -flto ${fileDirname}/*.c -o ${fileDirname}/engine",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build and run",
      "type": "shell",
      "command": "gcc -Wall -Wextra -g -std=c17 -O3 -march=native -flto ${fileDirname}/*.c -o ${fileDirname}/engine && ${fileDirname}/engine",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "build release",
      "type": "shell",
      "command": "gcc -Wall -Wextra -std=c17 -O3 -march=native -flto ${fileDirname}/*.c -o ${fileDirname}/engine",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "bench",
      "type": "shell",
      "command": "gcc -Wall -Wextra -std=c17 -O3 -march=native -flto ${fileDirname}/*.c -o ${fileDirname}/engine && ${fileDirname}/engine bench 6",
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}